# Connection string do Postgres (Supabase, Neon, local, etc.)
# No Supabase: Project Settings > Database > Connection string (modo "Transaction" ou "Session")
DATABASE_URL="postgresql://user:password@host:5432/db?schema=public"

# Chave usada para assinar o cookie de sessão (JWT). Gere uma com: openssl rand -base64 32
AUTH_SECRET="troque-esta-chave-em-producao"
